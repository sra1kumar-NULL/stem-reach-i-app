# Supabase
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# Postgres (Supabase connection string with password)
# Use the pooler host (aws-1-ap-northeast-2.pooler.supabase.com) — the direct
# db.<project>.supabase.co host fails to resolve from some providers.
# Find it under Supabase → Project Settings → Database → Connection pooling.
DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres

# Server
PORT=3000

# School calendar timezone (IANA). Defines "today" for activations, the feed,
# streaks and spaced-repetition due dates. Defaults to Asia/Kolkata.
APP_TIMEZONE=Asia/Kolkata

# Teacher self-signup invite code. Teachers must enter this to create an
# account; leave unset to disable teacher self-signup. Use a long random value.
TEACHER_INVITE_CODE=

# Number of reverse proxies in front of the API that append to X-Forwarded-For.
# The client IP (rate limiting) is read that many entries from the RIGHT. Render = 1.
# 0 = ignore the header and use the socket address (direct, no proxy).
TRUSTED_PROXY_HOPS=1

# Set to 1 to skip the boot-time check that the database has every column the code
# expects (escape hatch only; the API otherwise exits with the migration to run).
SKIP_SCHEMA_CHECK=
