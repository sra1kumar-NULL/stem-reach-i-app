# Build-time, PUBLIC values only. Everything prefixed EXPO_PUBLIC_ is inlined into the
# JS bundle that ships to every phone/browser - never put a server secret here
# (no service-role key, DB URL, TEACHER_INVITE_CODE...; those belong in api/.env).

# Supabase project URL and the *anon* (public) key.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<paste the anon key from the Supabase dashboard>

# Base URL of the deployed API (https, not localhost, for production builds).
EXPO_PUBLIC_API_URL=https://YOUR-API.onrender.com

# Public web origin of the app (the reset-link redirect target for native builds). Optional.
EXPO_PUBLIC_WEB_URL=https://YOUR-APP.vercel.app

# Set to 1 to show the "email me a reset link" form on Forgot password. Leave unset
# until custom SMTP works in Supabase (default recovery = teacher sets a temp password).
EXPO_PUBLIC_EMAIL_RESET=
