{
  "name": "daily-revision-app",
  "private": true,
  "version": "0.1.0",
  "description": "Daily Revision App — STEMRI.",
  "workspaces": [
    "core",
    "api",
    "scripts"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present && npm --prefix mobile run typecheck",
    "test": "npm test --workspaces --if-present && npm --prefix mobile test",
    "seed": "npm run seed -w scripts",
    "verify": "npm run verify -w scripts",
    "dev:api": "npm run dev -w api",
    "dev:web": "npm --prefix mobile run web",
    "dev:mobile": "npm --prefix mobile run dev",
    "dev:android": "npm --prefix mobile run android",
    "lint": "npm --prefix mobile run lint",
    "build:apk": "bash scripts/build-apk.sh"
  },
  "engines": {
    "node": ">=22.6"
  }
}
