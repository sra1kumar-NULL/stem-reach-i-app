{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run typecheck)",
      "Bash(npm run typecheck:*)",
      "Bash(npm run verify)",
      "Bash(npm run verify:*)",
      "Bash(npm test)",
      "Bash(npm test:*)",
      "Bash(npm run test:*)",
      "Bash(npm run lint:*)",
      "Bash(npm --prefix mobile run typecheck)",
      "Bash(npm --prefix mobile run lint)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(adb devices)",
      "Bash(adb devices:*)"
    ]
  }
}
